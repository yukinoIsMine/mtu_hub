# Shared Supabase project (Project Settings → API Keys).
# Copy into apps/user/.env.local and apps/admin/.env.local as needed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# User app only — AI thread summaries
GEMINI_API_KEY=

# Admin app only — never expose to the browser / never prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
