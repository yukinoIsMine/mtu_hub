# Supabase — Project Settings → API Keys in the dashboard.
# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
#
# Both values are safe to expose in the browser: the publishable key only grants
# whatever your Row Level Security policies allow. Never put the secret/service
# role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=